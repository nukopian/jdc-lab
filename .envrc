# The lab's environment, for direnv (see HOWTO.md). Run `direnv allow`
# after cloning, and again after any change here. Values that are yours
# alone, such as tokens, go in .env, which is git-ignored and read last.
# log_status, path_add, PATH_add and dotenv_if_exists are direnv's: see
# `man direnv-stdlib`.

# Python: the lab's venv, and the lab's own packages in python/lib.
if [[ -f .venv/bin/activate ]]; then
	source .venv/bin/activate
else
	log_status "no .venv yet, so no Python: see HOWTO.md"
fi
path_add PYTHONPATH python/lib

# Perl: perlbrew's perl-5.36.3, with the lab's library of CPAN modules,
# and the lab's own modules in perl/lib ahead of it.
perlbrew_root=${PERLBREW_ROOT:-$HOME/perl5/perlbrew}
perlbrew_home=${PERLBREW_HOME:-$HOME/.perlbrew}
if [[ -f $perlbrew_root/etc/bashrc && -d $perlbrew_home/libs/perl-5.36.3@jdc-lab ]]; then
	unset PERL5LIB # another library's modules, from the calling shell
	source "$perlbrew_root/etc/bashrc"
	perlbrew use perl-5.36.3@jdc-lab
	path_add PERL5LIB perl/lib

	# Inline::Python starts the venv's Python from its base install, which
	# doesn't see the venv's packages unless told where they are. They go
	# after python/lib, so the lab's own packages come first.
	python_version=$(<.python-version)
	export PYTHONPATH=$PYTHONPATH:$PWD/.venv/lib/python${python_version%.*}/site-packages
else
	log_status "no perlbrew perl-5.36.3@jdc-lab, so no Perl: see HOWTO.md"
fi

# Go: gvm's Go at the version go.mod asks for. This is all `gvm use` would
# do here, without the time it takes to load gvm.
gvm_root=${GVM_ROOT:-$HOME/.gvm}
go_version=go$(sed -n 's/^go //p' go.mod)
if [[ -x $gvm_root/gos/$go_version/bin/go ]]; then
	export GOROOT=$gvm_root/gos/$go_version
	PATH_add "$GOROOT/bin"
else
	log_status "no gvm $go_version, so whichever go is on PATH: see HOWTO.md"
fi
# `go install ./cmd/...` builds the lab's programs into bin/ (git-ignored).
export GOBIN=$PWD/bin

# The lab's programs and the repository's own scripts, runnable by name.
# Added even before bin/ exists: direnv only reads this file on entering
# the folder, so the first `go install` would otherwise need a reload.
PATH_add scripts
PATH_add bin

dotenv_if_exists .env
