# The lab's environment, for direnv (see HOWTO.md). Run `direnv allow`
# after cloning, and again after any change here. Values that are yours
# alone, such as tokens, go in .env, which is git-ignored and read last.

# Python: the lab's venv.
if [[ -f .venv/bin/activate ]]; then
	source .venv/bin/activate
else
	log_status "no .venv yet, so no Python: see HOWTO.md"
fi

# Perl: perlbrew's perl-5.36.3, with the lab's own library of modules.
perlbrew_root=${PERLBREW_ROOT:-$HOME/perl5/perlbrew}
perlbrew_home=${PERLBREW_HOME:-$HOME/.perlbrew}
if [[ -f $perlbrew_root/etc/bashrc && -d $perlbrew_home/libs/perl-5.36.3@jdc-lab ]]; then
	unset PERL5LIB # another library's modules, from the calling shell
	source "$perlbrew_root/etc/bashrc"
	perlbrew use perl-5.36.3@jdc-lab

	# Inline::Python starts the venv's Python from its base install, which
	# doesn't see the venv's packages unless told where they are.
	python_version=$(<.python-version)
	export PYTHONPATH=$PWD/.venv/lib/python${python_version%.*}/site-packages
else
	log_status "no perlbrew perl-5.36.3@jdc-lab, so no Perl: see HOWTO.md"
fi

dotenv_if_exists .env
