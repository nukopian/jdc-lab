# Values that are yours alone, read by .envrc
.env

# Working notes: they carry context that isn't for publishing
CLAUDE.md

# PDFs of the documents, built on demand by scripts/readme-pdf.sh
*.pdf

# VSCode
.vscode/

# Go
# Binaries: built into bin/ at the root (not python/bin or perl/bin, which
# hold programs), or beside the code by a bare `go build`
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binaries (go test -c), coverage profiles, pprof profiles, and
# VS Code's debugger builds
*.test
*.out
*.prof
__debug_bin*
# Workspace: local working copies of ../grammar and ../scalar
go.work
go.work.sum

# Python
.venv/
__pycache__/
*.pyc
# ruff's and pytest's caches (each also holds its own .gitignore)
.ruff_cache/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Perl
# Inline's build cache, made wherever a script using Inline runs
_Inline/
# Modules installed by Carton, beside a cpanfile
local/
# Building a module: left by Makefile.PL or Build.PL and make
blib/
_build/
pm_to_blib
MYMETA.*
*.o
*.bs
# Devel::Cover and Devel::NYTProf output
cover_db/
nytprof/
nytprof.out*
# Perl::Tidy's output files, backups and logs, when not writing to the
# screen or in place without a backup
*.tdy
*.bak
*.ERR
*.LOG

# Model weights and exported ONNX files
models/

# Job description data (may be large or not ours to publish): a folder,
# or a link to a private data store, so no trailing slash
/data

# macOS
.DS_Store
